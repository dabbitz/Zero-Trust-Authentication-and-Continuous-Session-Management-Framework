<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZeroTrustClient.StartPage">

	<ScrollView>
		<VerticalStackLayout x:Name="StartPageLayout" IsVisible="False" Padding="30" Spacing="25" HorizontalOptions="Center">

			<Label Text="Welcome to the Zero Trust App" FontSize="24" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                   FontAttributes="Bold" />

			<Button Text="Login" Clicked="OnLoginClicked" WidthRequest="250" HorizontalOptions="Center"/>

			<Button Text="Register" Clicked="OnRegisterClicked" WidthRequest="250" HorizontalOptions="Center"/>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>