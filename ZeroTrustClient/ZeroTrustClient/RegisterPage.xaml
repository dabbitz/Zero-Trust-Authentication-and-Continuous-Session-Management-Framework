<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZeroTrustClient.RegisterPage">

	<ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" HorizontalOptions="Center">

            <Label Text="Username" WidthRequest="550"/>
            <Entry x:Name="UsernameEntry" Placeholder="Enter username"/>

            <Label Text="Password" WidthRequest="550"/>
            <Entry x:Name="PasswordEntry" Placeholder="Enter password" IsPassword="True"/>

            <Button Text="Register" Clicked="OnRegisterClicked" WidthRequest="250" HorizontalOptions="Center"/>

            <Button Text="Go Back" Clicked="OnGoBackClicked" WidthRequest="250" HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>