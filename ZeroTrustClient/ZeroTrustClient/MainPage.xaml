<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZeroTrustClient.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label x:Name="StatusLabel" Text="Status: Not Authenticated" HorizontalOptions="Center" TextColor="Red" />

            <Button Text="Enter the App" Clicked="OnGoToAppPageClicked" HorizontalOptions="Center" WidthRequest="200"/>
            
            <Label Text="Current OTP:" FontAttributes="Bold" HorizontalOptions="Center"/>
            
            <Grid HeightRequest="150" WidthRequest="150" HorizontalOptions="Center">
                <GraphicsView x:Name="OtpTimerView" HeightRequest="150" WidthRequest="150" />

                <Label x:Name="OtpLabel" Text="------" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                    TextColor="White"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>