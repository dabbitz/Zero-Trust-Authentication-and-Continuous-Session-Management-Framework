<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZeroTrustClient.PhonePage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label Text="Enter the OTP sent to this device:" HorizontalOptions="Center" />

            <Entry x:Name="OtpEntry" 
                   Placeholder="123456" 
                   Keyboard="Numeric" 
                   HorizontalOptions="Center" 
                   WidthRequest="200"
                   MaxLength="6"/>

            <Button Text="Verify"
                    Clicked="OnVerifyClicked"
                    HorizontalOptions="Center"
                    WidthRequest="200"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>